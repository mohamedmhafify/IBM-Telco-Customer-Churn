      <column caption='Churned Customers' datatype='integer' name='[Calculation_1409875497504771]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Churn_Value])' />
      </column>
      <column caption='CLTV Lost' datatype='integer' default-format='c&quot;$&quot;#,##0,,.0M;(&quot;$&quot;#,##0,,.0M)' name='[Calculation_1409875501715460]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Churn_Value] = 1 THEN [CLTV] END)' />
