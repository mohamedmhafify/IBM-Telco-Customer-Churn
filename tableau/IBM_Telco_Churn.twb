                <zone h='88142' id='36' is-fixed='true' type-v2='layout-basic' w='83603' x='15811' y='6650'>
                  <zone h='88142' id='48' is-fixed='true' type-v2='layout-basic' w='83603' x='15811' y='6650'>
                    <zone h='11579' id='8' param='vert' type-v2='layout-flow' w='83603' x='15811' y='6650'>
                      <zone fixed-size='84' h='11579' id='33' is-fixed='true' type-v2='text' w='83603' x='15811' y='6650'>
                        <formatted-text>
                          <run bold='true' fontcolor='#0f2340' fontsize='20'>Insights &amp; Recommendations</run>
                          <run>Æ&#10;</run>
                          <run fontcolor='#525252' fontsize='13'>From analysis to action — the 5 biggest churn drivers and what to do about them.</run>
                        </formatted-text>
                        <zone-style>
                          <format attr='border-color' value='#000000' />
                          <format attr='border-style' value='none' />
                          <format attr='border-width' value='0' />
                          <format attr='margin' value='4' />
                        </zone-style>
                      </zone>
                    </zone>
                    <zone h='76563' id='49' param='vert' type-v2='layout-flow' w='83603' x='15811' y='18229'>
                      <zone fixed-size='112' forceUpdate='true' h='15312' id='35' is-fixed='true' type-v2='text' w='83603' x='15811' y='18229'>
                        <formatted-text>
                          <run bold='true' fontcolor='#da1e28' fontsize='13'>1 · Month-to-Month contracts drive churn</run>
                          <run>Æ&#10;</run>
                          <run bold='true' fontcolor='#525252' fontsize='11'>Finding</run>
                          <run fontcolor='#525252' fontsize='11'>: 45.8% churn on month-to-month vs 2.5% on two-year contracts.</run>
                          <run>Æ&#10;</run>
                          <run bold='true' fontcolor='#525252' fontsize='11'>Recommendation</run>
                          <run fontcolor='#525252' fontsize='11'>: Offer incentives to migrate customers to annual contracts.</run>
                          <run>Æ&#10;</run>
                          <run bold='true' fontcolor='#525252' fontsize='11'>Expected impact</run>
                          <run fontcolor='#525252' fontsize='11'>: Longer commitments sharply reduce churn risk.</run>
                        </formatted-text>
                        <zone-style>
                          <format attr='border-color' value='#525252' />
                          <format attr='border-style' value='solid' />
                          <format attr='border-width' value='1' />
                          <_.fcp.DashboardRoundedCorners.true...format attr='corner-radius' value='4' />
                          <format attr='margin' value='4' />
                          <format attr='padding' value='2' />
                          <format attr='background-color' value='#f4f4f4' />
                        </zone-style>
                      </zone>
                      <zone fixed-size='121' forceUpdate='true' h='15312' id='37' is-fixed='true' type-v2='text' w='83603' x='15811' y='33541'>
                        <formatted-text>
                          <run bold='true' fontcolor='#da1e28' fontname='Benton Sans Book' fontsize='13'>2 · The first year is the danger zone</run>
                          <run>Æ&#10;</run>
                          <run bold='true' fontcolor='#525252' fontsize='11'>Finding</run>
                          <run fontcolor='#525252' fontsize='11'>: 47.4% of customers churn within their first 12 months.</run>
                          <run>Æ&#10;</run>
                          <run bold='true' fontcolor='#525252' fontsize='11'>Recommendation</run>
                          <run fontcolor='#525252' fontsize='11'>: Launch a structured 90-day onboarding &amp; proactive support program.</run>
                          <run>Æ&#10;</run>
                          <run bold='true' fontcolor='#525252' fontsize='11'>Expected impact</run>
                          <run fontcolor='#525252' fontsize='11'>: Catches at-risk customers before they decide to leave.</run>
                        </formatted-text>
                        <zone-style>
                          <format attr='border-color' value='#000000' />
                          <format attr='border-style' value='solid' />
                          <format attr='border-width' value='1' />
                          <_.fcp.DashboardRoundedCorners.true...format attr='corner-radius' value='4' />
                          <format attr='margin' value='4' />
                          <format attr='padding' value='2' />
                          <format attr='background-color' value='#f4f4f4' />
                        </zone-style>
                      </zone>
                      <zone fixed-size='154' forceUpdate='true' h='15312' id='38' is-fixed='true' type-v2='text' w='83603' x='15811' y='48853'>
                        <formatted-text>
                          <run bold='true' fontcolor='#da1e28' fontsize='13'>3 · Competition is the #1 reason</run>
                          <run>Æ&#10;</run>
                          <run bold='true' fontcolor='#525252' fontsize='11'>Finding</run>
                          <run fontcolor='#525252' fontsize='11'>: 45% of churn is driven by competitors (better offers &amp; devices).</run>
                          <run>Æ&#10;</run>
                          <run bold='true' fontcolor='#525252' fontsize='11'>Recommendation</run>
                          <run fontcolor='#525252' fontsize='11'>: Review fiber pricing and introduce targeted retention offers.</run>
                          <run>Æ&#10;</run>
                          <run bold='true' fontcolor='#525252' fontsize='11'>Expected impact</run>
                          <run fontcolor='#525252' fontsize='11'>: Addresses the single largest churn cause.</run>
                        </formatted-text>
                        <zone-style>
                          <format attr='border-color' value='#000000' />
                          <format attr='border-style' value='solid' />
                          <format attr='border-width' value='1' />
                          <_.fcp.DashboardRoundedCorners.true...format attr='corner-radius' value='4' />
                          <format attr='margin' value='4' />
                          <format attr='padding' value='2' />
                          <format attr='background-color' value='#f4f4f4' />
                        </zone-style>
                      </zone>
                      <zone fixed-size='117' forceUpdate='true' h='15312' id='39' is-fixed='true' type-v2='text' w='83603' x='15811' y='64165'>
                        <formatted-text>
                          <run bold='true' fontcolor='#da1e28' fontsize='13'>4 · Fiber users are high-value &amp; high-risk</run>
                          <run>Æ&#10;</run>
                          <run bold='true' fontsize='11'>Finding</run>
                          <run fontsize='11'>: 40.7% churn among fiber customers — they make up 66% of all churners.</run>
                          <run>Æ&#10;</run>
                          <run bold='true' fontsize='11'>Recommendation</run>
                          <run fontsize='11'>: Improve fiber quality/price and monitor satisfaction closely.</run>
                          <run>Æ&#10;</run>
                          <run bold='true' fontsize='11'>Expected impact</run>
                          <run fontsize='11'>: Protects the largest revenue segment at risk.</run>
                        </formatted-text>
                        <zone-style>
                          <format attr='border-color' value='#000000' />
                          <format attr='border-style' value='solid' />
                          <format attr='border-width' value='1' />
                          <_.fcp.DashboardRoundedCorners.true...format attr='corner-radius' value='4' />
                          <format attr='margin' value='4' />
                          <format attr='padding' value='2' />
                          <format attr='background-color' value='#f4f4f4' />
                        </zone-style>
                      </zone>
                      <zone fixed-size='116' forceUpdate='true' h='15315' id='40' is-fixed='true' type-v2='text' w='83603' x='15811' y='79477'>
                        <formatted-text>
                          <run bold='true' fontcolor='#da1e28' fontsize='13'>5 · No protection = higher churn</run>
                          <run>Æ&#10;</run>
                          <run bold='true' fontcolor='#525252' fontsize='11'>Finding</run>
                          <run fontcolor='#525252' fontsize='11'>: 33.4% churn without Online Security or Tech Support, vs 9% with both.</run>
                          <run>Æ&#10;</run>
                          <run bold='true' fontcolor='#525252' fontsize='11'>Recommendation</run>
                          <run fontcolor='#525252' fontsize='11'>: Bundle security &amp; support add-ons at a discounted rate.</run>
                          <run>Æ&#10;</run>
                          <run bold='true' fontcolor='#525252' fontsize='11'>Expected impact</run>
                          <run fontcolor='#525252' fontsize='11'>: Increases stickiness and lowers churn.</run>
                        </formatted-text>
                        <zone-style>
                          <format attr='border-color' value='#000000' />
                          <format attr='border-style' value='solid' />
                          <format attr='border-width' value='1' />
                          <_.fcp.DashboardRoundedCorners.true...format attr='corner-radius' value='4' />
                          <format attr='margin' value='4' />
                          <format attr='padding' value='2' />
                          <format attr='background-color' value='#f4f4f4' />
                        </zone-style>
                      </zone>
                    </zone>
                  </zone>
                </zone>
