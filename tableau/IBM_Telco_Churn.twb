                    <zone fixed-size='38' forceUpdate='true' h='5990' id='31' is-fixed='true' type-v2='text' w='15225' x='586' y='37120'>
                      <formatted-text>
                        <run bold='true' fontalignment='1' fontcolor='#000000' fontsize='12'>Recommendations</run>
                      </formatted-text>
                      <zone-style>
                        <format attr='border-color' value='#000000' />
