      <column caption='Tenure Group' datatype='string' name='[Calculation_1409875502702597]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Tenure_in_Months] &lt;= 12 THEN &quot;0-12&quot;&#13;&#10;ELSEIF [Tenure_in_Months] &lt;= 24 THEN &quot;13-24&quot;&#13;&#10;ELSEIF [Tenure_in_Months] &lt;= 48 THEN &quot;25-48&quot;&#13;&#10;ELSE &quot;49+&quot;&#13;&#10;END' />
      </column>
      <column caption='Population Density' datatype='string' name='[Calculation_1409875593011210]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Population] &lt; 20000 THEN &quot;Low Density&quot;&#13;&#10;ELSEIF [Population] &lt;= 50000 THEN &quot;Medium Density&quot;&#13;&#10;ELSE &quot;High Density&quot;&#13;&#10;END' />
      </column>
